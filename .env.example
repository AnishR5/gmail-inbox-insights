# --- Postgres / Redis (match docker-compose.yml if you use it) ---
DATABASE_URL="postgresql://gmail_insights:gmail_insights@localhost:5432/gmail_insights"
REDIS_URL="redis://localhost:6379"

# --- Server ---
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
NODE_ENV=development

# --- Session cookie signing (generate: openssl rand -base64 48) ---
SESSION_SECRET="replace-with-a-long-random-string"

# --- Token-at-rest encryption, AES-256-GCM (generate: openssl rand -base64 32) ---
KEY_ENCRYPTION_KEY="replace-with-32-random-bytes-base64"

# --- Google OAuth client (see README.md "Google Cloud Console setup") ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/auth/google/callback"

# --- Frontend ---
VITE_API_BASE_URL="http://localhost:4000"
